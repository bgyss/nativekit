+/* The RAM refresh counter is machine state no event carries. The lockstep
+ * schedule (D05) takes it from the original at the clocks it imposes: as it
+ * stood when the current 68000 bus access began, or as it stands now. */
+static uint32_t decomp_refresh_mark_counter, decomp_refresh_mark_sync;
+
+void gen_decomp_refresh_mark(m68k_context *context)
+{
+	genesis_context *gen = context->system;
+	decomp_refresh_mark_counter = gen->refresh_counter;
+	decomp_refresh_mark_sync = gen->last_sync_cycle;
+}
+
+void nmd_decomp_refresh_state(uint32_t at_access_start, uint32_t *counter, uint64_t *last_sync)
+{
+	genesis_context *gen = (genesis_context *)current_system;
+	*counter = at_access_start ? decomp_refresh_mark_counter : gen->refresh_counter;
+	*last_sync = nmd_decomp_clock(at_access_start ? decomp_refresh_mark_sync : gen->last_sync_cycle);
+}
+
+void gen_decomp_refresh_impose(m68k_context *context, uint32_t counter, uint64_t last_sync)
+{
+	genesis_context *gen = context->system;
+	gen->refresh_counter = counter;
+	gen->last_sync_cycle = nmd_decomp_local_clock(last_sync);
+}
