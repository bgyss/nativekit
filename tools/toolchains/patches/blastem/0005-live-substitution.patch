+int nmd_decomp_m68k_live_resume(const uint32_t *d, const uint32_t *a, uint32_t other_sp,
+                                uint32_t sr, uint32_t pc, uint64_t master_clock,
+                                uint32_t refresh_counter, uint64_t refresh_sync,
+                                int64_t sync_after, int64_t interrupt_after, int64_t target_after,
+                                int64_t slice_after, uint32_t pending)
+{
+	m68k_context *context = live_context;
+	uint32_t cycles;
+
+	if (!context) {
+		return -1;
+	}
+	memcpy(context->dregs, d, sizeof context->dregs);
+	memcpy(context->aregs, a, sizeof context->aregs);
+	context->other_sp = other_sp;
+	context->status = sr >> 8;
+	context->xflag = sr & 0x10 ? 128 : 0;
+	context->nflag = sr & 0x08 ? 128 : 0;
+	context->zflag = sr & 0x04 ? 1 : 0;
+	context->vflag = sr & 0x02 ? 128 : 0;
+	context->cflag = sr & 0x01 ? 128 : 0;
+	cycles = nmd_decomp_local_clock(master_clock);
