+		if (width == 1) {
+			m68k_read_8(context);
+		} else {
+			m68k_read_16(context);
+		}
+		value = context->scratch1;
+	}
+	if (master_clock == NMD_DECOMP_UNTIMED) {
+		context->cycles = saved;
+	}
