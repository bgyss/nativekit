+	 * taken at the boundary after it */
+	context->int_pending = (uint8_t)pending;
+	context->int_pending_num = (uint8_t)(pending >> 8);
+	live_slice_end = (uint32_t)((int64_t)cycles + slice_after);
+	context->int_cycle = interrupt_after == INT64_MAX ? 0xFFFFFFFFU
+		: (uint32_t)((int64_t)cycles + interrupt_after);
+	live_resumed = 1;
+	return 0;
