+/* The comparison snapshot for the lockstep check (D05): what both CPUs and
+ * the VDP hold that a game can observe, one region at a time. */
+size_t nmd_decomp_snapshot(uint32_t region, uint8_t *out, size_t capacity,
+                           char *name, size_t name_capacity)
+{
+	genesis_context *gen = (genesis_context *)current_system;
+	static const char *names[] = {"m68k", "z80", "work_ram", "z80_ram", "vram", "cram",
+	                              "vsram", "vdp_registers"};
+	uint8_t cpu[128];
+	const void *data = cpu;
+	size_t size = 0;
+
+	if (!gen || region >= sizeof names / sizeof names[0]) {
+		return 0;
+	}
+	memset(cpu, 0, sizeof cpu);
+	if (region == 0) {
+		m68k_context *m68k = gen->m68k;
+		uint64_t clock = nmd_decomp_clock(m68k->cycles);
+		uint32_t pc = m68k->pc - 2;
+		uint8_t flags[8] = {m68k->status, m68k->xflag != 0, m68k->nflag != 0, m68k->zflag != 0,
+		                    m68k->vflag != 0, m68k->cflag != 0, m68k->stopped != 0, 0};
+		memcpy(cpu, m68k->dregs, 32);
+		memcpy(cpu + 32, m68k->aregs, 32);
+		memcpy(cpu + 64, &m68k->other_sp, 4);
+		memcpy(cpu + 68, &pc, 4);
+		memcpy(cpu + 72, flags, 8);
+		memcpy(cpu + 80, &m68k->prefetch, 2);
+		memcpy(cpu + 84, &clock, 8);
+		size = 92;
+	} else if (region == 1) {
+		z80_context *z80 = gen->z80;
+		uint64_t clock = nmd_decomp_clock(z80->cycles);
+		uint8_t rest[12] = {
+			(uint8_t)((z80->last_flag_result & 0xA8) | (z80->zflag ? 0x40 : 0) |
+			          (z80->chflags & 8 ? 0x10 : 0) | (z80->pvflag ? 4 : 0) |
+			          (z80->nflag ? 2 : 0) | (z80->chflags & 0x80 ? 1 : 0)),
+			z80->i, z80->iff1 != 0, z80->iff2 != 0, z80->imode, z80->busreq != 0,
+			z80->busack != 0, z80->reset != 0, 0, 0, 0, 0};
+		memcpy(cpu, z80->main, 6);
+		cpu[6] = z80->main[7];
+		memcpy(cpu + 8, z80->alt, 8);
+		memcpy(cpu + 16, &z80->ix, 2);
+		memcpy(cpu + 18, &z80->iy, 2);
+		memcpy(cpu + 20, &z80->sp, 2);
+		memcpy(cpu + 22, &z80->pc, 2);
+		memcpy(cpu + 24, rest, 12);
+		memcpy(cpu + 36, &clock, 8);
+		size = 44;
+	} else if (region == 2) {
+		data = gen->work_ram;
+		size = RAM_WORDS * 2;
+	} else if (region == 3) {
+		data = gen->zram;
+		size = Z80_RAM_BYTES;
+	} else if (region == 4) {
+		data = gen->vdp->vdpmem;
+		size = VRAM_SIZE;
+	} else if (region == 5) {
+		data = gen->vdp->cram;
+		size = sizeof gen->vdp->cram;
+	} else if (region == 6) {
+		data = gen->vdp->vsram;
+		size = sizeof gen->vdp->vsram;
+	} else {
+		data = gen->vdp->regs;
+		size = sizeof gen->vdp->regs;
+	}
+	if (size > capacity || !name_capacity) {
+		return 0;
+	}
+	memcpy(out, data, size);
+	strncpy(name, names[region], name_capacity - 1);
+	name[name_capacity - 1] = 0;
+	return size;
+}
