 void gen_update_refresh(m68k_context *context)
 {
 	genesis_context *gen = context->system;
@@ -4031,3 +4057,80 @@ genesis_context* alloc_config_pico(void *rom, uint32_t rom_size, void *lock_on,
 #endif
