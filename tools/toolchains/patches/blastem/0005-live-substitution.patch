+	if (!context || (width != 1 && width != 2)) {
+		nmd_decomp_fail();
+		return 0;
+	}
+	saved = context->cycles;
+	if (master_clock != NMD_DECOMP_UNTIMED) {
+		context->cycles = nmd_decomp_local_clock(master_clock);
+		gen_decomp_refresh_impose(context, refresh_counter, refresh_sync);
+	}
+	if (write) {
+		context->scratch2 = address;
+		context->scratch1 = value;
+		if (width == 1) {
