+static void z80_decomp_publish_transition(z80_context *context, uint32_t kind,
+                                         uint32_t vector, uint32_t reason,
+                                         uint32_t phase, uint16_t pc,
+                                         uint16_t next_pc)
+{
+	struct nmd_decomp_event event = {0};
+	event.struct_size = sizeof event;
+	event.kind = kind;
+	event.cpu = NMD_DECOMP_Z80;
+	event.master_clock = nmd_decomp_clock(context->cycles);
+	event.epoch = nmd_decomp_clock_epoch();
+	event.pc = pc;
+	event.next_pc = next_pc;
+	event.payload.interrupt.vector = vector;
+	event.payload.interrupt.reason = reason;
+	event.payload.interrupt.phase = phase;
+	event.payload.interrupt.stack_pointer = context->sp;
+	nmd_decomp_publish(&event);
+}
+
+void z80_decomp_interrupt(z80_context *context, uint32_t vector, uint32_t reason)
+{
+	context->decomp_event_vector = vector;
+	context->decomp_event_reason = reason;
+	context->decomp_event_active = 1;
+	z80_decomp_publish_transition(context, NMD_DECOMP_INTERRUPT, vector, reason, 1,
+		context->decomp_instruction_pc, vector);
+}
+
+void z80_decomp_return(z80_context *context)
+{
+	if (!context->decomp_event_active) {
+		return;
+	}
+	z80_decomp_publish_transition(context, NMD_DECOMP_INTERRUPT,
+		context->decomp_event_vector, context->decomp_event_reason, 2,
+		context->decomp_instruction_pc, context->pc);
+	context->decomp_event_active = 0;
+}
+
+void z80_decomp_reset_event(z80_context *context)
+{
+	context->decomp_active = 0;
+	context->decomp_fetch_len = 0;
+	context->decomp_pending_fetch = 0;
+	context->decomp_event_active = 0;
+	z80_decomp_publish_transition(context, NMD_DECOMP_RESET, 0, 0, 1, 0, context->pc);
+}
+
+static uint8_t z80_decomp_emit_instruction(z80_context *context, uint16_t next_pc)
+{
+	struct nmd_decomp_event event = {0};
+	event.struct_size = sizeof event;
+	event.kind = NMD_DECOMP_INSTRUCTION;
+	event.cpu = NMD_DECOMP_Z80;
+	event.master_clock = nmd_decomp_clock(context->cycles);
+	event.epoch = nmd_decomp_clock_epoch();
+	event.pc = context->decomp_instruction_pc;
+	event.next_pc = next_pc;
+	event.payload.instruction.fetched_length = context->decomp_fetch_len;
+	memcpy(event.payload.instruction.fetched_bytes, context->decomp_fetch_bytes,
+	       context->decomp_fetch_len);
+	event.payload.instruction.opcode = context->decomp_fetch_bytes[0];
+	z80_decomp_copy_state(context, &event.payload.instruction.state.z80);
+	enum nmd_decomp_action action = nmd_decomp_publish(&event);
+
+	event = (struct nmd_decomp_event){0};
+	event.struct_size = sizeof event;
+	event.kind = NMD_DECOMP_FLOW_EDGE;
+	event.cpu = NMD_DECOMP_Z80;
+	event.master_clock = nmd_decomp_clock(context->cycles);
+	event.epoch = nmd_decomp_clock_epoch();
+	event.pc = context->decomp_instruction_pc;
+	event.next_pc = next_pc;
+	event.payload.flow.previous_pc = context->decomp_instruction_pc;
+	event.payload.flow.current_pc = next_pc;
+	event.payload.flow.target_known = 1;
+	nmd_decomp_publish(&event);
+	if (context->decomp_event_active && context->decomp_fetch_len >= 2 &&
+	    context->decomp_fetch_bytes[0] == 0xED &&
+	    ((context->decomp_fetch_bytes[1] & 0xC7) == 0x45 ||
+	     context->decomp_fetch_bytes[1] == 0x4D)) {
+		z80_decomp_return(context);
+	}
+	return action != NMD_DECOMP_CONTINUE ||
+		nmd_decomp_should_stop_cpu(NMD_DECOMP_Z80,
+			nmd_decomp_clock(context->cycles));
+}
