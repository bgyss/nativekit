diff --git a/z80_util.c b/z80_util.c
index 2b46182..65d20d0 100644
--- a/z80_util.c
+++ b/z80_util.c
@@ -2,0 +3 @@
+#include "decomp_abi.h"
@@ -13,0 +15,103 @@ static void z80_trace_read(z80_context *context, uint32_t address, uint8_t value
+	if (operation == NMD_TRACE_FETCH) {
+		z80_decomp_note_fetch(context, address, value);
+	}
+}
+
+void z80_decomp_note_fetch(z80_context *context, uint32_t address, uint8_t value)
+{
+	context->decomp_pending_pc = address & 0xFFFF;
+	context->decomp_pending_value = value;
+	context->decomp_pending_fetch = 1;
+}
+
+static void z80_decomp_fail(void)
+{
+	struct nmd_decomp_event invalid = {0};
+	nmd_decomp_publish(&invalid);
+}
+
+static void z80_decomp_emit_instruction(z80_context *context, uint16_t next_pc)
+{
+	struct nmd_decomp_event event = {0};
+	struct nmd_decomp_z80_state *state;
+	event.struct_size = sizeof event;
+	event.kind = NMD_DECOMP_INSTRUCTION;
+	event.cpu = NMD_DECOMP_Z80;
+	event.master_clock = (uint64_t)context->cycles * context->opts->gen.clock_divider;
+	event.pc = context->decomp_instruction_pc;
+	event.next_pc = next_pc;
+	event.payload.instruction.fetched_length = context->decomp_fetch_len;
+	memcpy(event.payload.instruction.fetched_bytes, context->decomp_fetch_bytes,
+	       context->decomp_fetch_len);
+	event.payload.instruction.opcode = context->decomp_fetch_bytes[0];
+	state = &event.payload.instruction.state.z80;
+	memcpy(state->main, context->main, sizeof state->main);
+	memcpy(state->alt, context->alt, sizeof state->alt);
+	state->cycles = context->cycles;
+	state->sync_cycle = context->sync_cycle;
+	state->nmi_cycle = context->nmi_cycle;
+	state->int_end_cycle = context->int_end_cycle;
+	state->int_cycle = context->int_cycle;
+	state->wz = context->wz;
+	state->sp = context->sp;
+	state->pc = context->pc;
+	state->iy = context->iy;
+	state->ix = context->ix;
+	state->i = context->i;
+	state->r = context->r;
+	state->rhigh = context->rhigh;
+	state->zflag = context->zflag;
+	state->reset = context->reset;
+	state->pvflag = context->pvflag;
+	state->nflag = context->nflag;
+	state->last_flag_result = context->last_flag_result;
+	state->int_value = context->int_value;
+	state->imode = context->imode;
+	state->iff2 = context->iff2;
+	state->iff1 = context->iff1;
+	state->chflags = context->chflags;
+	state->busreq = context->busreq;
+	state->busack = context->busack;
+	nmd_decomp_publish(&event);
+
+	event = (struct nmd_decomp_event){0};
+	event.struct_size = sizeof event;
+	event.kind = NMD_DECOMP_FLOW_EDGE;
+	event.cpu = NMD_DECOMP_Z80;
+	event.master_clock = (uint64_t)context->cycles * context->opts->gen.clock_divider;
+	event.pc = context->decomp_instruction_pc;
+	event.next_pc = next_pc;
+	event.payload.flow.previous_pc = context->decomp_instruction_pc;
+	event.payload.flow.current_pc = next_pc;
+	event.payload.flow.target_known = 1;
+	nmd_decomp_publish(&event);
+}
+
+void z80_decomp_dispatch(z80_context *context, uint8_t table, uint8_t opcode)
+{
+	if (!context->decomp_pending_fetch) {
+		return;
+	}
+	if (table == 0) {
+		if (context->decomp_active) {
+			z80_decomp_emit_instruction(context, context->decomp_pending_pc);
+		}
+		context->decomp_instruction_pc = context->decomp_pending_pc;
+		context->decomp_fetch_len = 0;
+		context->decomp_active = 1;
+	} else if (!context->decomp_active) {
+		context->decomp_instruction_pc = context->decomp_pending_pc;
+		context->decomp_fetch_len = 0;
+		context->decomp_active = 1;
+	}
+	if (context->decomp_fetch_len >= 16) {
+		context->decomp_pending_fetch = 0;
+		z80_decomp_fail();
+		return;
+	}
+	context->decomp_fetch_bytes[context->decomp_fetch_len++] =
+		context->decomp_pending_value;
+	context->decomp_pending_fetch = 0;
+	if (context->decomp_pending_value != opcode) {
+		z80_decomp_fail();
+	}
