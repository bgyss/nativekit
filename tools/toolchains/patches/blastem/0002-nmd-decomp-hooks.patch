+uint8_t z80_decomp_dispatch(z80_context *context, uint8_t table, uint8_t opcode)
+{
+	if (!context->decomp_pending_fetch) {
+		return 0;
+	}
+	if (table == 0) {
+		if (context->decomp_active) {
+			if (z80_decomp_emit_instruction(context, context->decomp_pending_pc)) {
+				context->decomp_pending_fetch = 0;
+				return 1;
+			}
+		}
+		context->decomp_instruction_pc = context->decomp_pending_pc;
+		context->decomp_fetch_len = 0;
+		context->decomp_active = 1;
+	} else if (!context->decomp_active) {
+		context->decomp_instruction_pc = context->decomp_pending_pc;
+		context->decomp_fetch_len = 0;
+		context->decomp_active = 1;
+	}
+	if (context->decomp_fetch_len >= 16) {
+		context->decomp_pending_fetch = 0;
+		z80_decomp_fail();
+		return 1;
+	}
+	context->decomp_fetch_bytes[context->decomp_fetch_len++] =
+		context->decomp_pending_value;
+	context->decomp_pending_fetch = 0;
+	if (context->decomp_pending_value != opcode) {
+		z80_decomp_fail();
+		return 1;
+	}
+	return nmd_decomp_should_stop_cpu(NMD_DECOMP_Z80,
+		nmd_decomp_clock(context->cycles));
