diff --git a/m68k_util.c b/m68k_util.c
index ca58189..eae41e3 100644
--- a/m68k_util.c
+++ b/m68k_util.c
@@ -2,0 +3 @@
+#include "decomp_abi.h"
@@ -11,0 +13,151 @@ void m68k_trace_mark_fetch(m68k_context *context)
+void m68k_decomp_begin_instruction(m68k_context *context)
+{
+	context->decomp_instruction_pc = context->pc - 2;
+	context->decomp_instruction_opcode = context->prefetch;
+}
+
+void m68k_decomp_copy_state(m68k_context *context, struct nmd_decomp_m68k_state *state)
+{
+	memcpy(state->d, context->dregs, sizeof state->d);
+	memcpy(state->a, context->aregs, sizeof state->a);
+	state->other_sp = context->other_sp;
+	state->cycles = context->cycles;
+	state->target_cycle = context->target_cycle;
+	state->sync_cycle = context->sync_cycle;
+	state->int_cycle = context->int_cycle;
+	state->prefetch = context->prefetch;
+	state->status = context->status;
+	state->ccr = context->ccr;
+	state->xflag = context->xflag;
+	state->nflag = context->nflag;
+	state->zflag = context->zflag;
+	state->vflag = context->vflag;
+	state->cflag = context->cflag;
+	state->trace_pending = context->trace_pending;
+	state->stopped = context->stopped;
+	state->int_priority = context->int_priority;
+	state->int_pending_num = context->int_pending_num;
+	state->int_pending = context->int_pending;
+	state->int_num = context->int_num;
+	state->int_ack = context->int_ack;
+}
+
+static void m68k_decomp_bus_access(m68k_context *context, uint32_t start_cycle,
+                                   uint32_t address, uint32_t value, uint8_t width,
+                                   uint8_t operation, uint8_t provenance)
+{
+	struct nmd_decomp_event event = {0};
+	event.struct_size = sizeof event;
+	event.kind = NMD_DECOMP_BUS_ACCESS;
+	event.cpu = NMD_DECOMP_M68K;
+	event.master_clock = nmd_decomp_clock(context->cycles);
+	event.epoch = nmd_decomp_clock_epoch();
+	event.pc = context->decomp_instruction_pc & context->opts->gen.address_mask;
+	event.next_pc = (context->pc - 2) & context->opts->gen.address_mask;
+	event.payload.bus.start_clock = nmd_decomp_clock(start_cycle);
+	event.payload.bus.completion_clock = nmd_decomp_clock(context->cycles);
+	event.payload.bus.address = address;
+	event.payload.bus.value = value;
+	event.payload.bus.width = width;
+	event.payload.bus.operation = operation;
+	event.payload.bus.provenance = provenance;
+	nmd_decomp_publish(&event);
+}
+
+static void m68k_decomp_publish_transition(m68k_context *context, uint32_t kind,
+                                          uint32_t vector, uint32_t reason,
+                                          uint32_t phase, uint32_t pc,
+                                          uint32_t next_pc)
+{
+	struct nmd_decomp_event event = {0};
+	event.struct_size = sizeof event;
+	event.kind = kind;
+	event.cpu = NMD_DECOMP_M68K;
+	event.master_clock = nmd_decomp_clock(context->cycles);
+	event.epoch = nmd_decomp_clock_epoch();
+	event.pc = pc & context->opts->gen.address_mask;
+	event.next_pc = next_pc & context->opts->gen.address_mask;
+	event.payload.interrupt.vector = vector;
+	event.payload.interrupt.reason = reason;
+	event.payload.interrupt.phase = phase;
+	event.payload.interrupt.stack_pointer = context->aregs[7];
+	nmd_decomp_publish(&event);
+}
+
+void m68k_decomp_exception(m68k_context *context, uint32_t vector)
+{
+	context->decomp_event_kind = NMD_DECOMP_EXCEPTION;
+	context->decomp_event_vector = vector;
+	context->decomp_event_active = 1;
+	m68k_decomp_publish_transition(context, NMD_DECOMP_EXCEPTION, vector, 0, 1,
+		context->decomp_instruction_pc, context->pc - 2);
+}
+
+void m68k_decomp_interrupt(m68k_context *context)
+{
+	uint32_t vector = 24 + context->int_ack;
+	context->decomp_event_kind = NMD_DECOMP_INTERRUPT;
+	context->decomp_event_vector = vector;
+	context->decomp_event_active = 1;
+	m68k_decomp_publish_transition(context, NMD_DECOMP_INTERRUPT, vector, 1, 1,
+		context->decomp_instruction_pc, context->pc - 2);
+}
+
+void m68k_decomp_return(m68k_context *context)
+{
+	if (!context->decomp_event_active) {
+		return;
+	}
+	m68k_decomp_publish_transition(context, context->decomp_event_kind,
+		context->decomp_event_vector, 0, 2,
+		context->decomp_instruction_pc, context->pc - 2);
+	context->decomp_event_active = 0;
+}
+
+void m68k_decomp_reset_event(m68k_context *context, uint32_t address)
+{
+	context->decomp_event_active = 0;
+	m68k_decomp_publish_transition(context, NMD_DECOMP_RESET, 0, 0, 1, 0, address);
+}
+
+int m68k_decomp_complete_instruction(m68k_context *context)
+{
+	struct nmd_decomp_event event = {0};
+	uint32_t address_mask = context->opts->gen.address_mask;
+	uint32_t pc = context->decomp_instruction_pc & address_mask;
+	uint32_t next_pc = (context->pc - 2) & address_mask;
+	uint16_t opcode = context->decomp_instruction_opcode;
+
+	event.struct_size = sizeof event;
+	event.kind = NMD_DECOMP_INSTRUCTION;
+	event.cpu = NMD_DECOMP_M68K;
+	event.master_clock = nmd_decomp_clock(context->cycles);
+	event.epoch = nmd_decomp_clock_epoch();
+	event.pc = pc;
+	event.next_pc = next_pc;
+	event.payload.instruction.fetched_length = 2;
+	event.payload.instruction.fetched_bytes[0] = opcode >> 8;
+	event.payload.instruction.fetched_bytes[1] = opcode;
+	event.payload.instruction.opcode = opcode;
+	m68k_decomp_copy_state(context, &event.payload.instruction.state.m68k);
+	nmd_decomp_publish(&event);
+
+	event = (struct nmd_decomp_event){0};
+	event.struct_size = sizeof event;
+	event.kind = NMD_DECOMP_FLOW_EDGE;
+	event.cpu = NMD_DECOMP_M68K;
+	event.master_clock = nmd_decomp_clock(context->cycles);
+	event.epoch = nmd_decomp_clock_epoch();
+	event.pc = pc;
+	event.next_pc = next_pc;
+	event.payload.flow.previous_pc = pc;
+	event.payload.flow.current_pc = next_pc;
+	event.payload.flow.target_known = 1;
+	nmd_decomp_publish(&event);
+	if (opcode == 0x4E73) {
+		m68k_decomp_return(context);
+	}
+	return nmd_decomp_should_stop_cpu(NMD_DECOMP_M68K,
+		nmd_decomp_clock(context->cycles));
+}
+
