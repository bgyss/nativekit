+static void decomp_synchronized_handoff(genesis_context *gen)
+{
+	m68k_context *m68k = gen->m68k;
+	z80_context *z80 = gen->z80;
+	sync_z80(gen, m68k->cycles);
+
+	uint64_t z80_clock = z80->cycles;
+	uint64_t clock = m68k->cycles > z80_clock ? m68k->cycles : z80_clock;
+	if (gen->vdp->cycles > clock) {
+		clock = gen->vdp->cycles;
+	}
+	if (gen->ym->current_cycle > clock) {
+		clock = gen->ym->current_cycle;
+	}
+	if (gen->psg->cycles > clock) {
+		clock = gen->psg->cycles;
+	}
+
+	for (uint8_t pass = 0; pass < 16; pass++) {
+		sync_sound(gen, clock);
+		vdp_run_context(gen->vdp, clock);
+		io_run(gen->io.ports, clock);
+		io_run(gen->io.ports + 1, clock);
+		io_run(gen->io.ports + 2, clock);
+		if (gen->expansion) {
+			scd_run(gen->expansion, gen_cycle_to_scd(clock, gen));
+		}
+		if (gen->mars) {
+			s32x_run(gen->mars, clock);
+		}
+		uint64_t next_clock = clock;
+		if (gen->vdp->cycles > next_clock) {
+			next_clock = gen->vdp->cycles;
+		}
+		if (gen->ym->current_cycle > next_clock) {
+			next_clock = gen->ym->current_cycle;
+		}
+		if (gen->psg->cycles > next_clock) {
+			next_clock = gen->psg->cycles;
+		}
+		if (next_clock == clock) {
+			break;
+		}
+		clock = next_clock;
+	}
+	if (gen->vdp->cycles != clock || gen->ym->current_cycle != clock ||
+	    gen->psg->cycles != clock) {
+		struct nmd_decomp_event invalid = {0};
+		nmd_decomp_publish(&invalid);
+		return;
+	}
+	if (clock >= gen->last_sync_cycle) {
+		gen->refresh_counter += clock - gen->last_sync_cycle;
+		gen->last_sync_cycle = clock;
+		gen->refresh_counter %= MCLKS_PER_68K * REFRESH_INTERVAL;
+	}
+	gen->frame_end = vdp_cycles_to_frame_end(gen->vdp);
+	m68k->sync_cycle = gen->frame_end;
+
+	struct nmd_decomp_event event = {0};
+	event.struct_size = sizeof event;
+	event.kind = nmd_decomp_stop_action() == NMD_DECOMP_REPLACE ?
+		NMD_DECOMP_REPLACE_EVENT : NMD_DECOMP_STOP_EVENT;
+	event.cpu = nmd_decomp_stop_cpu();
+	event.master_clock = nmd_decomp_clock(clock);
+	event.epoch = nmd_decomp_clock_epoch();
+	event.pc = nmd_decomp_stop_pc();
+	event.next_pc = nmd_decomp_stop_next_pc();
+	nmd_decomp_fill_stop(&event.payload.handoff.stop);
+	event.payload.handoff.stop.stop_clock = event.master_clock;
+	event.payload.handoff.master_clock = event.master_clock;
+	event.payload.handoff.z80_master_clock = nmd_decomp_clock(z80->cycles);
+	event.payload.handoff.vdp_clock = nmd_decomp_clock(gen->vdp->cycles);
+	event.payload.handoff.ym_clock = nmd_decomp_clock(gen->ym->current_cycle);
+	event.payload.handoff.psg_clock = nmd_decomp_clock(gen->psg->cycles);
+	event.payload.handoff.io_clock = event.master_clock;
+	m68k_decomp_copy_state(m68k, &event.payload.handoff.m68k);
+	z80_decomp_copy_state(z80, &event.payload.handoff.z80);
+	nmd_decomp_mark_handed_off();
+	nmd_decomp_publish(&event);
+}
+
