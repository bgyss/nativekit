+		return source == NULL;
+	}
+	uint32_t mask = load_int32(buf);
+	uint8_t num_channels = load_int8(buf);
+	uint32_t buffer_pos = load_int32(buf);
+	uint32_t read_start = load_int32(buf);
+	uint32_t read_end = load_int32(buf);
+	uint32_t lowpass_alpha = load_int32(buf);
+	uint8_t front_populated = load_int8(buf);
+	int16_t last_left = (int16_t)load_int16(buf);
+	int16_t last_right = (int16_t)load_int16(buf);
+	uint64_t buffer_fraction = nmd_decomp_load_u64(buf);
+	uint64_t buffer_inc = nmd_decomp_load_u64(buf);
+	uint32_t sample_count = mask + 1;
+	if (!source || source->mask != mask || source->num_channels != num_channels ||
+	    !source->back || source->front != source->back || !sample_count) {
+		return 0;
+	}
+	load_buffer16(buf, (uint16_t *)source->back, sample_count);
+	source->buffer_pos = buffer_pos;
+	source->read_start = read_start;
+	source->read_end = read_end;
+	source->lowpass_alpha = lowpass_alpha;
+	source->front_populated = front_populated;
+	source->last_left = last_left;
