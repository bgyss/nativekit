diff --git a/m68k_util.c b/m68k_util.c
index 8aa7171..8c1de0f 100644
--- a/m68k_util.c
+++ b/m68k_util.c
@@ -1,8 +1,14 @@
 #include <string.h>
+#include "trace_abi.h"
 #ifdef DEBUG_DISASM
 #include "68kinst.h"
 #endif
 
+void m68k_trace_mark_fetch(m68k_context *context)
+{
+	context->trace_fetch = 1;
+}
+
 void m68k_read_8(m68k_context *context)
 {
 	context->cycles += 4 * context->opts->gen.clock_divider;
@@ -12,6 +18,7 @@ void m68k_read_8(m68k_context *context)
 	uint32_t address = context->scratch1 & context->opts->gen.address_mask;
 	uint32_t index = address >> 16;
 	context->scratch1 = context->read8[index](address, context, context->read8_data[index]);
+	nmd_trace_emit(context->cycles, NMD_TRACE_M68K, NMD_TRACE_READ, 1, address, context->scratch1);
 #ifdef DEBUG_DISASM
 	printf("Read.b %05X: %02X\n", tmp, context->scratch1);
 #endif
@@ -32,6 +39,9 @@ void m68k_read_16(m68k_context *context)
 	uint32_t address = context->scratch1 & context->opts->gen.address_mask;
 	uint32_t index = address >> 16;
 	context->scratch1 = context->read16[index](address, context, context->read16_data[index]);
+	uint8_t operation = context->trace_fetch ? NMD_TRACE_FETCH : NMD_TRACE_READ;
+	context->trace_fetch = 0;
+	nmd_trace_emit(context->cycles, NMD_TRACE_M68K, operation, 2, address, context->scratch1);
 #ifdef DEBUG_DISASM
 	if (tmp == context->pc) {
 		m68kinst inst;
@@ -54,6 +64,7 @@ void m68k_write_8(m68k_context *context)
 	uint32_t address = context->scratch2 & context->opts->gen.address_mask;
 	uint32_t index = address >> 16;
 	context->write8[index](address, context, context->scratch1, context->write8_data[index]);
+	nmd_trace_emit(context->cycles, NMD_TRACE_M68K, NMD_TRACE_WRITE, 1, address, context->scratch1);
 #ifdef DEBUG_DISASM
 	printf("Write.b %05X: %02X\n", context->scratch2, context->scratch1);
 #endif
@@ -74,6 +85,8 @@ void m68k_write_16(m68k_context *context)
 	int32_t address = context->scratch2 & context->opts->gen.address_mask;
 	uint32_t index = address >> 16;
 	context->write16[index](address, context, context->scratch1, context->write16_data[index]);
+	nmd_trace_emit(context->cycles, NMD_TRACE_M68K, NMD_TRACE_WRITE, 2,
+	               context->scratch2 & context->opts->gen.address_mask, context->scratch1);
 #ifdef DEBUG_DISASM
 	printf("Write %05X: %04X\n", context->scratch2, context->scratch1);
 #endif
@@ -259,6 +272,7 @@ m68k_context *init_68k_context(m68k_options * opts, m68k_reset_handler *reset_ha
 
 void m68k_reset(m68k_context *context)
 {
+	context->trace_fetch = 0;
 	//read initial SP
 	context->scratch1 = 0;
 	m68k_read_16(context);
@@ -276,6 +290,7 @@ void m68k_reset(m68k_context *context)
 	context->pc |= context->scratch1;
 	
 	context->scratch1 = context->pc;
+	context->trace_fetch = 1;
 	m68k_read_16(context);
 	context->prefetch = context->scratch1;
 	context->pc += 2;
@@ -369,6 +384,7 @@ void m68k_deserialize(deserialize_buffer *buf, void *vcontext)
 void start_68k_context(m68k_context *context, uint32_t pc)
 {
 	context->scratch1 = context->pc = pc;
+	context->trace_fetch = 1;
 	m68k_read_16(context);
 	context->prefetch = context->scratch1;
 	context->pc += 2;
