# Fails the configure when a file under kit/ names a console: the kit is
# console independent (docs/superpowers/specs/2026-10-30-nativekit-extraction-design.md).
file(GLOB_RECURSE _kit_files ${NK_DIR}/*)
set(_bad "")
foreach(f ${_kit_files})
  if(f MATCHES "/tests/kit_names\\.cmake$" OR f MATCHES "/__pycache__/")
    continue()
  endif()
  # hidden files and folders (.DS_Store, .git) and editor backups are not the kit's
  file(RELATIVE_PATH _rel ${NK_DIR} ${f})
  if(_rel MATCHES "(^|/)\\." OR _rel MATCHES "(~|\\.swp|\\.orig)$")
    continue()
  endif()
  file(READ ${f} _text)
  string(TOLOWER "${_text}" _low)
  foreach(word snes nshvc "super nintendo" "super famicom" ppu spc700 spc_ 65816 s-cpu "mode 7" mode7 bsnes nativeshvc .sfx)
    string(FIND "${_low}" "${word}" _at)
    if(NOT _at EQUAL -1)
      list(APPEND _bad "${f}: ${word}")
    endif()
  endforeach()
endforeach()
if(_bad)
  string(REPLACE ";" "\n  " _list "${_bad}")
  message(FATAL_ERROR "nativekit names a console:\n  ${_list}")
endif()
if(CMAKE_SCRIPT_MODE_FILE)
  message("kit_names: ok")
endif()
